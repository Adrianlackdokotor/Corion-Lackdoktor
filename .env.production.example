# Required runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/corion_db
SESSION_SECRET=replace-with-a-long-random-secret

# Public domain / Google OAuth
CORION_PUBLIC_APP_URL=https://app.corion.app
CORION_BASE_URL=https://app.corion.app
APP_URL=https://app.corion.app
CORION_GOOGLE_OAUTH_CLIENT_JSON=/absolute/path/to/google-oauth-client.json
CORION_GOOGLE_OAUTH_TOKEN_JSON=/absolute/path/to/google-oauth-token.json
CORION_GOOGLE_OAUTH_REDIRECT_URI=https://app.corion.app/api/google/oauth/callback
CORION_SYSTEM_USER_ID=replace-with-admin-user-uuid

# Telegram production webhook (all three are required for a usable secure webhook)
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
TELEGRAM_ALLOWED_CHAT_IDS=replace-with-comma-separated-chat-ids

# Trusted agent intake
AGENT_TASK_SERVICE_TOKEN=replace-with-random-service-token

# Email notifications/password reset (manual provider credential)
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=noreply@corion-lackdoktor.de
